PREFIX ex: <http://example.org/>
PREFIX ont: <https://prez.dev/ont/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ex:catalogues-listing
    a
        ont:DynamicEndpoint ,
        ont:ListingEndpoint ;
    rdfs:label "Catalogues Listing" ;
    ont:apiPath "/catalogues" ;
    ont:relevantShapes ex:shape-R0-HL1 ;
.

ex:catalogues-object
    a
        ont:DynamicEndpoint ,
        ont:ObjectEndpoint ;
    rdfs:label "Catalogues Object" ;
    ont:apiPath "/catalogues/{catalogId}" ;
    ont:relevantShapes ex:shape-R0-HL1 ;
.

ex:collections-listing
    a
        ont:DynamicEndpoint ,
        ont:ListingEndpoint ;
    rdfs:label "Collections Listing" ;
    ont:apiPath "/catalogues/{catalogId}/collections" ;
    ont:relevantShapes ex:shape-R0-HL2 ;
.

ex:collections-object
    a
        ont:DynamicEndpoint ,
        ont:ObjectEndpoint ;
    rdfs:label "Collections Object" ;
    ont:apiPath "/catalogues/{catalogId}/collections/{recordsCollectionId}" ;
    ont:relevantShapes ex:shape-R0-HL2 ;
.

ex:items-listing
    a
        ont:DynamicEndpoint ,
        ont:ListingEndpoint ;
    rdfs:label "Items Listing" ;
    ont:apiPath "/catalogues/{catalogId}/collections/{recordsCollectionId}/items" ;
    ont:relevantShapes ex:shape-R0-HL3 ;
.

ex:items-object
    a
        ont:DynamicEndpoint ,
        ont:ObjectEndpoint ;
    rdfs:label "Items Object" ;
    ont:apiPath "/catalogues/{catalogId}/collections/{recordsCollectionId}/items/{itemId}" ;
    ont:relevantShapes ex:shape-R0-HL3 ;
.

ex:shape-R0-HL1
    a sh:NodeShape ;
    sh:property
        [
            sh:or (

                [
                    sh:class skos:ConceptScheme ;
                ]

                [
                    sh:class owl:Ontology ;
                ]

                [
                    sh:class sh:ShapesGraph ;
                ]

                [
                    sh:class schema:Dataset ;
                ]
            ) ;
            sh:path schema:hasPart ;
        ] ;
    sh:targetClass schema:DataCatalog ;
    ont:hierarchyLevel 1 ;
.

ex:shape-R0-HL2
    a sh:NodeShape ;
    sh:property
        [
            sh:class schema:DataCatalog ;
            sh:path
                [
                    sh:inversePath schema:hasPart ;
                ] ;
        ] ;
    sh:targetClass
        owl:Ontology ,
        schema:Dataset ,
        sh:ShapesGraph ,
        skos:ConceptScheme ;
    ont:hierarchyLevel 2 ;
.

ex:shape-R0-HL3
    a sh:NodeShape ;
    sh:property
        [
            sh:class skos:ConceptScheme ;
            sh:path skos:inScheme ;
        ] ,
        [
            sh:class schema:DataCatalog ;
            sh:path (
                skos:inScheme

                [
                    sh:inversePath schema:hasPart ;
                ]
            ) ;
        ] ;
    sh:targetClass skos:Concept, skos:Collection ;
    ont:hierarchyLevel 3 ;
.
