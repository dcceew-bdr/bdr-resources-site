ARG NODE_VERSION=22-alpine
ARG PNPM_VERSION=10.12.1
ARG PREZ_UI_VERSION=4.3.3
ARG NUXT_PUBLIC_PREZ_API_ENDPOINT=http://localhost:3000/api

FROM node:${NODE_VERSION} AS build

ARG PNPM_VERSION
ARG PREZ_UI_VERSION
ARG NUXT_PUBLIC_PREZ_API_ENDPOINT

ENV PNPM_HOME=/pnpm
ENV PATH=/pnpm:$PATH
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ENV NUXT_PUBLIC_PREZ_API_ENDPOINT=${NUXT_PUBLIC_PREZ_API_ENDPOINT}

RUN corepack enable \
    && corepack prepare pnpm@${PNPM_VERSION} --activate

RUN pnpm dlx create-prez-app@${PREZ_UI_VERSION} /app

WORKDIR /app

# The BDR layer targets Prez UI 4.1's root-based Nuxt layout. Prez UI 4.3's
# starter also contains an app/ tree, which Nuxt would otherwise discover
# alongside the overlaid layer and compile as a second, incompatible source.
RUN rm -rf /app/app

COPY overrides/ /app/

# The starter can leave empty UI component directories. shadcn-nuxt expects
# every directory here to contain an index module, even for unused components.
RUN find /app/components/ui -mindepth 1 -type d -empty -delete

# shadcn-nuxt generates this helper and provides the @/lib/utils alias.
RUN rm -f /app/lib/utils.ts

RUN pnpm install --frozen-lockfile
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm generate

FROM nginx:alpine

# The official Nginx entrypoint substitutes PREZ_UPSTREAM into this template
# when the container starts.
COPY nginx.conf /etc/nginx/templates/nginx.conf.template
ENV NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx

COPY --from=build /app/.output/public /usr/share/nginx/html

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
